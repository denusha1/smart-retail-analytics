# Enable live MySQL mode with a SQLAlchemy-compatible connection string.
# Example: mysql+pymysql://retail_user:strong-password@localhost:3306/smart_retail
DATABASE_URL=

# Replace demo credentials before production deployment.
RETAIL_ADMIN_EMAIL=admin@company.lk
RETAIL_ADMIN_PASSWORD=replace-with-a-strong-password
# Supabase REST connection (recommended for the hosted dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
